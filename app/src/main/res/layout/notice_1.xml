<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noticeStudentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 영역 -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/menu"
            android:tint="#555555" />
    </LinearLayout>

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- 제목 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="강의 공지"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- 흰색 큰 박스 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/noticeMainCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/noticeFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ========================= -->
                <!-- 1. 학생용 공지 목록 화면 -->
                <!-- ========================= -->
                <LinearLayout
                    android:id="@+id/studentNoticeListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- 내부 상단바 -->
                    <LinearLayout
                        android:id="@+id/noticeTopBar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="#F2F5FA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvStudentNoticePageTitle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center_vertical"
                            android:text="공지사항"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNoticeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="#E4F2FF"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="총 3개"
                            android:textColor="#1685D4"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 필터/안내 영역 -->
                    <LinearLayout
                        android:id="@+id/studentNoticeInfoArea"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/tvCurrentLectureName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="머신러닝 및 실습"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNoticeDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="교수님이 등록한 강의 일정 및 출결 관련 공지를 확인할 수 있습니다."
                            android:textColor="#777777"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E4E4E4" />

                    <!-- Kotlin에서 RecyclerView로 교체 가능 -->
                    <ScrollView
                        android:id="@+id/studentNoticeScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/studentNoticeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="16dp">

                            <!-- 공지 아이템 1 -->
                            <LinearLayout
                                android:id="@+id/itemNotice1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFFFFF"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvNoticeBadge1"
                                        android:layout_width="54dp"
                                        android:layout_height="28dp"
                                        android:background="#1685D4"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="중요"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvNoticeDate1"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="2026-05-11"
                                        android:textColor="#888888"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvNoticeItemTitle1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:text="5월 13일 수업 일정 변경 안내"
                                    android:textColor="#111111"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNoticeItemContent1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="강의실 변경 및 출석 체크 시간이 조정될 예정입니다. 수업 전 반드시 확인 바랍니다."
                                    android:textColor="#666666"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvNoticeProfessor1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="작성자 : 이상웅 교수"
                                    android:textColor="#999999"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#E4E4E4" />

                            <!-- 공지 아이템 2 -->
                            <LinearLayout
                                android:id="@+id/itemNotice2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFFFFF"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvNoticeBadge2"
                                        android:layout_width="54dp"
                                        android:layout_height="28dp"
                                        android:background="#F2F5FA"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="일반"
                                        android:textColor="#555555"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvNoticeDate2"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="2026-05-09"
                                        android:textColor="#888888"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvNoticeItemTitle2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:text="PIN 출석 입력 관련 안내"
                                    android:textColor="#111111"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNoticeItemContent2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="블루투스 출석이 정상적으로 되지 않은 학생은 교수님 안내에 따라 PIN을 입력해주시기 바랍니다."
                                    android:textColor="#666666"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvNoticeProfessor2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="작성자 : 이상웅 교수"
                                    android:textColor="#999999"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#E4E4E4" />

                            <!-- 공지 아이템 3 -->
                            <LinearLayout
                                android:id="@+id/itemNotice3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFFFFF"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvNoticeBadge3"
                                        android:layout_width="54dp"
                                        android:layout_height="28dp"
                                        android:background="#F2F5FA"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="일반"
                                        android:textColor="#555555"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvNoticeDate3"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="2026-05-07"
                                        android:textColor="#888888"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvNoticeItemTitle3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:text="중간 출석 체크 안내"
                                    android:textColor="#111111"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNoticeItemContent3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="수업 중 UWB 기반 중간 출석 체크가 진행됩니다. 수업 중 강의실 이탈 시 결석 처리될 수 있습니다."
                                    android:textColor="#666666"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvNoticeProfessor3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="작성자 : 이상웅 교수"
                                    android:textColor="#999999"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <!-- ========================= -->
                <!-- 2. 학생용 공지 상세 화면 -->
                <!-- Kotlin에서 공지 클릭 시 visible -->
                <!-- ========================= -->
                <LinearLayout
                    android:id="@+id/studentNoticeDetailContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/detailTopBar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="#F2F5FA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageButton
                            android:id="@+id/btnBackToNoticeList"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:tint="#222222" />

                        <TextView
                            android:id="@+id/tvDetailPageTitle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:text="공지 상세"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/detailScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/detailContentArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvDetailBadge"
                                android:layout_width="60dp"
                                android:layout_height="30dp"
                                android:background="#1685D4"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text="중요"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/pretendard_bold"
                                android:text="5월 13일 수업 일정 변경 안내"
                                android:textColor="#111111"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="작성자 : 이상웅 교수  |  작성일 : 2026-05-11"
                                android:textColor="#777777"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="18dp"
                                android:background="#E4E4E4" />

                            <TextView
                                android:id="@+id/tvDetailContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="5dp"
                                android:text="강의 일정 안내 내용이 표시되는 영역입니다.&#10;&#10;교수님이 notice_2.xml 화면에서 작성한 공지 제목, 공지 내용, 작성일, 중요 여부 등을 백엔드에서 받아와 이 영역에 표시하면 됩니다.&#10;&#10;예시) 이번 주 수업은 강의실 변경으로 인해 AI공학관 000호에서 진행됩니다. 출석 체크는 수업 시작 후 15분 이내에 진행되며, 블루투스 인증이 되지 않는 경우 PIN 입력을 통해 출석을 완료해주세요."
                                android:textColor="#333333"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>