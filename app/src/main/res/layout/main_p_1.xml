<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainProfessorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="105dp"
            android:layout_height="40dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/menu"
            android:tint="#6E6E6E" />
    </LinearLayout>

    <!-- 날짜 / 교시 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDatePeriod"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_medium"
                android:text="2026.03.26 금"
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="1교시"
                android:textColor="#4A4A4A"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 수업명 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardClassInfo"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="모바일 프로그래밍"
                android:textColor="#004B83"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/tabler_clock"
                    android:tint="#555555" />

                <TextView
                    android:id="@+id/tvClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="10:00 ~ 10:50"
                    android:textColor="#444444"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 메인 영역 -->
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- 학생 출석 현황 표 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStudentAttendanceTable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <!-- 표 제목 / 인원 카운트 -->
                <LinearLayout
                    android:id="@+id/tableTopArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/tvAttendanceListTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="학생 출석 현황"
                        android:textColor="#004B83"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_medium"
                        android:text="총 30명"
                        android:textColor="#777777"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 출석 진행 안내 문구 -->
                <TextView
                    android:id="@+id/tvAttendanceProcessNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="초기 출석 체크 전입니다."
                    android:textColor="#777777"
                    android:textSize="10sp" />

                <!-- 구분선 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DADADA" />

                <!-- 표 헤더 -->
                <LinearLayout
                    android:id="@+id/tableHeader"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="#F3F6FA"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHeaderStudentId"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.35"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:text="학번"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderStudentName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.9"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:text="이름"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderPresent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.7"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:text="출석"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderAbsent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.7"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:text="결석"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderLate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.7"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:text="지각"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 학생 리스트: 백엔드에서 받아온 학생 정보를 Kotlin에서 이 영역에 row 추가 -->
                <ScrollView
                    android:id="@+id/scrollStudentAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:id="@+id/layoutStudentAttendanceRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 예시 Row 1 -->
                        <LinearLayout
                            android:id="@+id/rowStudentSample1"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="#FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStudentId1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.35"
                                android:fontFamily="@font/pretendard_medium"
                                android:gravity="center"
                                android:text="202431880"
                                android:textColor="#444444"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvStudentName1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.9"
                                android:fontFamily="@font/pretendard_medium"
                                android:gravity="center"
                                android:text="최은수"
                                android:textColor="#444444"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvPresentCheck1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#005BAC"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvAbsentCheck1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#D00000"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvLateCheck1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#673AB7FF"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE" />

                        <!-- 예시 Row 2 -->
                        <LinearLayout
                            android:id="@+id/rowStudentSample2"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="#FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStudentId2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.35"
                                android:fontFamily="@font/pretendard_medium"
                                android:gravity="center"
                                android:text="202431881"
                                android:textColor="#444444"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvStudentName2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.9"
                                android:fontFamily="@font/pretendard_medium"
                                android:gravity="center"
                                android:text="김가천"
                                android:textColor="#444444"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvPresentCheck2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#005BAC"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvAbsentCheck2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#D00000"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvLateCheck2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#673AB7"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE" />

                        <!-- 예시 Row 3 -->
                        <LinearLayout
                            android:id="@+id/rowStudentSample3"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="#FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStudentId3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.35"
                                android:fontFamily="@font/pretendard_medium"
                                android:gravity="center"
                                android:text="202431882"
                                android:textColor="#444444"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvStudentName3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.9"
                                android:fontFamily="@font/pretendard_medium"
                                android:gravity="center"
                                android:text="박출석"
                                android:textColor="#444444"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvPresentCheck3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#005BAC"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvAbsentCheck3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#D00000"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvLateCheck3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.7"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#673AB7FF"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 하단 상태 영역 -->
        <LinearLayout
            android:id="@+id/layoutProfessorBottomStateArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 출석체크 시작 전 / 시작 직후 영역 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfessorControlBefore15"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginBottom="10dp"
                android:visibility="visible"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="18dp">

                    <!-- PIN 표시 영역 -->
                    <LinearLayout
                        android:id="@+id/layoutPinArea"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPinGuide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/pretendard_medium"
                            android:text="출석체크 시작 시 PIN 표시"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:id="@+id/layoutPinBoxes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPinDigit1"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="#E1E1E1"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#004B83"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPinDigit2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="#E1E1E1"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#004B83"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPinDigit3"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:background="#E1E1E1"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#004B83"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPinDigit4"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="#E1E1E1"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#004B83"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnProfessorAttendanceCheck"
                        android:layout_width="78dp"
                        android:layout_height="58dp"
                        android:backgroundTint="#005BAC"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="출석\n체크"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 수업 시작 15분 이후 출석률 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfessorControlAfter15"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- 왼쪽: 수업명 + 출석률 -->
                    <LinearLayout
                        android:id="@+id/layoutAttendanceRateArea"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAfter15ClassName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="모바일 프로그래밍"
                            android:textColor="#004B83"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAttendanceRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="66%"
                            android:textColor="#005BAC"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAttendanceRateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="38dp"
                            android:fontFamily="@font/pretendard_medium"
                            android:text="출석률"
                            android:textColor="#777777"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- 가운데 구분선 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="14dp"
                        android:background="#D9D9D9" />

                    <!-- 오른쪽: 지각률 / 결석률 -->
                    <LinearLayout
                        android:id="@+id/layoutLateAbsentRateArea"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLateRateLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="지각률"
                                android:textColor="#777777"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvLateRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/pretendard_bold"
                                android:text="3%"
                                android:textColor="#9C27B0"
                                android:textSize="21sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAbsentRateLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_medium"
                                android:text="결석률"
                                android:textColor="#777777"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvAbsentRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/pretendard_bold"
                                android:text="31%"
                                android:textColor="#D00000"
                                android:textSize="21sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- UWB 중간 출석 체크 상태 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardUwbMiddleCheck"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUwbTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="UWB 중간 출석 체크 중"
                            android:textColor="#004B83"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUwbDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/pretendard_medium"
                            android:text="5분 간격 체크 · 3회 이상 미인증 시 결석 처리"
                            android:textColor="#777777"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUwbCheckCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="0/3"
                        android:textColor="#005BAC"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 호명 출석 버튼 -->
            <Button
                android:id="@+id/btnRollCallAttendance"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#005BAC"
                android:fontFamily="@font/pretendard_bold"
                android:text="호명 출석"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#004B83"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>